<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:scanning="using:Tokenizers.Scanning"
             xmlns:controls="using:TokenVisualizer.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="TokenVisualizer.Views.ExplorerPage">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Row 0: page header -->
        <Grid ColumnDefinitions="*,Auto" Margin="20,16,20,0">
            <StackPanel Spacing="2">
                <TextBlock Text="Token 浏览" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="打开文件夹扫描 token 数，点选文件查看逐 token 着色。" Opacity="0.6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnOpenFolder" Content="打开文件夹" Classes="accent" Padding="16,8"/>
                <Button x:Name="BtnRescan" Content="重新扫描" Padding="12,8" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: toolbar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="20,10,20,6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="分词器：" Opacity="0.7"/>
                <TextBlock x:Name="TxtActiveTokenizer" Text="未加载" Opacity="0.7"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnCancelScan" Content="取消扫描" Padding="12,8" IsVisible="False"/>
            </StackPanel>
        </Grid>

        <!-- Row 2: body -->
        <Grid Grid.Row="2" ColumnDefinitions="340,4,*" Margin="20,0,20,16">

            <!-- Left: folder tree -->
            <Grid RowDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                    <TextBlock Text="项目" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TblRootCount" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                </StackPanel>
                <TreeView x:Name="FileTree" Grid.Row="1">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="scanning:ScanTreeNode">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding CountText}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Right: token-colored file view -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <Border Padding="12,8" Margin="0,0,0,6">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TblFileName" FontWeight="Bold"/>
                        <TextBlock x:Name="TblFileMeta" FontSize="12" Opacity="0.6"/>
                    </StackPanel>
                </Border>
                <controls:TokenizedViewer x:Name="TokenLines" Grid.Row="1" EmptyHint="选择文件查看 token 着色"/>
            </Grid>

        </Grid>

    </Grid>
</UserControl>
