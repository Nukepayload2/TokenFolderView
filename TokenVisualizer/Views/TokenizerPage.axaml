<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="TokenVisualizer.Views.TokenizerPage">

    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: page header + toolbar -->
        <Grid ColumnDefinitions="*,Auto" Margin="20,16,20,0">
            <StackPanel Spacing="2">
                <TextBlock Text="分词器" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="管理 tokenizer（tokenizer.json + tokenizer_config.json）" Opacity="0.6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnAdd" Content="添加分词器…" Classes="accent" Padding="16,8"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: tokenizer list -->
        <ScrollViewer Grid.Row="1" Margin="20,12,20,16">
            <ListBox x:Name="TokenizerList" Background="Transparent"/>
        </ScrollViewer>

    </Grid>
</UserControl>
