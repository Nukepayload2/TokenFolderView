<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="TokenVisualizer.Views.MainWindow"
        Title="词元文件夹视图"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="True"
        Width="1200" Height="800" MinWidth="900" MinHeight="600">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Row 0: extended title bar (drag region only; the window Title is the sole title) -->
        <Border x:Name="TitleBarBorder" Height="48" Padding="0,0,140,0" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"/>
        <!-- Row 1: navigation -->
        <ui:FANavigationView Grid.Row="1" x:Name="NavView"
                             AlwaysShowHeader="False" PaneDisplayMode="Left" IsSettingsVisible="True"
                             OpenPaneLength="280" IsBackButtonVisible="False" IsPaneToggleButtonVisible="True"/>
        <!-- Row 2: status bar -->
        <Border Grid.Row="2" x:Name="StatusBarBorder" Height="34" BorderThickness="0,1,0,0" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotalTokens" FontSize="14" FontWeight="Bold" Text="总计 0 tokens"/>
                    <TextBlock x:Name="TxtFilesScanned" Text="文件 0"/>
                    <TextBlock x:Name="TxtFilesSkipped" Text="跳过 0"/>
                    <TextBlock x:Name="TxtScanStatus" Opacity="0.6" Text="就绪"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ProgressBar x:Name="ScanProgressBar" Width="160" Height="14" IsVisible="False"/>
                    <Button x:Name="BtnCancelScan" Content="取消" IsVisible="False" Padding="12,4"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
