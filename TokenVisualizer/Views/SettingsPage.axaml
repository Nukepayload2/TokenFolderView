<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:TokenVisualizer.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TokenVisualizer.Views.SettingsPage">

    <ScrollViewer>
        <StackPanel Margin="24,16" Spacing="16">

            <TextBlock Text="设置" FontSize="28" FontWeight="Bold"/>

            <!-- 分词器 -->
            <ui:FASettingsExpander Header="分词器" Description="管理 tokenizer 模型（tokenizer.json + tokenizer_config.json）" IconSource="Setting">
                <controls:TokenizerSettingsSection/>
            </ui:FASettingsExpander>

            <!-- 扫描 -->
            <ui:FASettingsExpander Header="扫描" Description="控制扫描的过滤规则、文件大小上限与二进制检测" IconSource="FolderOpen">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="最大文件大小" Opacity="0.8"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:FANumberBox x:Name="NumMaxSize" Minimum="0.1" Maximum="10240" SmallChange="1" Value="10" Width="180"/>
                            <TextBlock Text="MB" Opacity="0.6" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <ToggleSwitch x:Name="TglCheckBinary" OnContent="跳过二进制文件" OffContent="不跳过二进制文件"/>

                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="文件夹黑名单（每行一个）" Opacity="0.8" VerticalAlignment="Center"/>
                            <Button x:Name="BtnResetBlacklist" Grid.Column="1" Content="恢复默认" Padding="12,4"/>
                        </Grid>
                        <TextBox x:Name="TxtBlacklist" AcceptsReturn="True" Height="120"
                                 FontFamily="Cascadia Code,Consolas,Courier New" TextWrapping="NoWrap"/>
                    </StackPanel>
                </StackPanel>
            </ui:FASettingsExpander>

            <!-- 外观 -->
            <ui:FASettingsExpander Header="外观" Description="切换应用主题" IconSource="Color">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="主题" Opacity="0.8"/>
                        <ComboBox x:Name="CboTheme" MinWidth="180">
                            <ComboBoxItem Content="跟随系统" Tag="System"/>
                            <ComboBoxItem Content="浅色" Tag="Light"/>
                            <ComboBoxItem Content="深色" Tag="Dark"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ui:FASettingsExpander>

            <!-- 关于 -->
            <ui:FASettingsExpander Header="关于" Description="项目主页与版权" IconSource="Link">
                <StackPanel Spacing="8">
                    <TextBlock Text="TokenFolderView · 版本 1.1.0" FontSize="16" FontWeight="SemiBold"/>
                    <Button x:Name="BtnHomepage"
                            Content="https://github.com/Nukepayload2/TokenFolderView/"
                            HorizontalAlignment="Left"
                            Padding="12,6"
                            Cursor="Hand"/>
                    <TextBlock Text="本软件受中国和国际版权法保护。源代码与产品以 MIT 许可发布；内置分词器数据遵循其自身许可。"
                               Opacity="0.6" TextWrapping="Wrap"/>
                </StackPanel>
            </ui:FASettingsExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
