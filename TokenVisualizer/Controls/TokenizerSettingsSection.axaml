<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:TokenVisualizer.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="TokenVisualizer.Controls.TokenizerSettingsSection">

    <StackPanel Spacing="8">

        <ListBox x:Name="TokenizerList" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="controls:TokenizerListItem">
                    <!-- No extra card background: let the library ListBoxItem supply the row visuals. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                        IsVisible="{Binding IsActive}"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="使用中" FontSize="11"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="使用" Classes="accent" Padding="12,6" IsVisible="{Binding !IsActive}"/>
                            <Button Content="删除" Padding="12,6" IsVisible="{Binding !IsBundled}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="TblEmpty" TextWrapping="Wrap" Opacity="0.5" IsVisible="False"
                   Text="还没有分词器。点击「添加分词器…」，选择 tokenizer.json 与 tokenizer_config.json。"/>

        <!-- Add is a plain row pinned below the list -->
        <Button x:Name="BtnAdd" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Add" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="添加分词器" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

    </StackPanel>

</UserControl>
